  </main>

  <script>
    (function () {
      const stage = document.getElementById('stage');
      const svg = document.getElementById('robot-svg');
      const zoomLabel = document.getElementById('zoom-label');
      const btnGrid = document.getElementById('btn-grid');
      const btnZoomIn = document.getElementById('btn-zoom-in');
      const btnZoomOut = document.getElementById('btn-zoom-out');
      const btnReset = document.getElementById('btn-reset');
      const btnDownload = document.getElementById('btn-download');

      let scale = 1;
      let panX = 0;
      let panY = 0;
      let isDragging = false;
      let startX = 0;
      let startY = 0;

      function updateTransform() {
        svg.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
        zoomLabel.textContent = `${Math.round(scale * 100)}%`;
      }

      function clampScale(val) {
        return Math.min(Math.max(val, 0.4), 4.5);
      }

      // Zoom controls
      btnZoomIn.addEventListener('click', () => {
        scale = clampScale(scale + 0.25);
        updateTransform();
      });

      btnZoomOut.addEventListener('click', () => {
        scale = clampScale(scale - 0.25);
        updateTransform();
      });

      btnReset.addEventListener('click', () => {
        scale = 1;
        panX = 0;
        panY = 0;
        updateTransform();
      });

      // Toggle background inspection grid
      btnGrid.addEventListener('click', () => {
        const active = document.body.classList.toggle('bg-inspect-grid');
        btnGrid.classList.toggle('bg-neutral-900', active);
        btnGrid.classList.toggle('text-white', active);
      });

      // Mouse wheel zoom
      stage.addEventListener('wheel', (e) => {
        e.preventDefault();
        const delta = e.deltaY < 0 ? 0.12 : -0.12;
        scale = clampScale(scale + delta);
        updateTransform();
      }, { passive: false });

      // Pan drag support (mouse & touch)
      stage.addEventListener('mousedown', (e) => {
        if (e.target.closest('#controls')) return;
        isDragging = true;
        startX = e.clientX - panX;
        startY = e.clientY - panY;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        panX = e.clientX - startX;
        panY = e.clientY - startY;
        updateTransform();
      });

      window.addEventListener('mouseup', () => {
        isDragging = false;
      });

      stage.addEventListener('touchstart', (e) => {
        if (e.target.closest('#controls') || e.touches.length !== 1) return;
        isDragging = true;
        startX = e.touches[0].clientX - panX;
        startY = e.touches[0].clientY - panY;
      }, { passive: true });

      stage.addEventListener('touchmove', (e) => {
        if (!isDragging || e.touches.length !== 1) return;
        panX = e.touches[0].clientX - startX;
        panY = e.touches[0].clientY - startY;
        updateTransform();
      }, { passive: true });

      stage.addEventListener('touchend', () => {
        isDragging = false;
      });

      // Clean SVG file export
      btnDownload.addEventListener('click', () => {
        try {
          const clone = svg.cloneNode(true);
          clone.removeAttribute('style');
          clone.setAttribute('width', '1000');
          clone.setAttribute('height', '1000');
          const serializer = new XMLSerializer();
          const source = '<?xml version="1.0" encoding="UTF-8"?>\n' + serializer.serializeToString(clone);
          const blob = new Blob([source], { type: 'image/svg+xml;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'steampunk_piggybank_robot.svg';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        } catch (err) {
          console.error('Export failed:', err);
        }
      });

      // ================= WALK ENGINE =================
      // Articulated legs (hip > knee > ankle) driven by one phase value.
      // Body height is solved from forward kinematics so the lowest foot always
      // touches the ground (no floating / sinking). The loop sleeps when idle.
      const $ = (id) => document.getElementById(id);
      const D = Math.PI / 180, GY = 911, S = 46, F = 37;
      const HIPS = [{ x: 498, y: 782, T: 46 }, { x: 622, y: 772, T: 56 }];
      const actor = $('actor'), bodyG = $('body'), legsG = $('legs-group'), groundLine = $('ground-line');
      const btnFx = $('btn-fx'), btnRun = $('btn-run');

      const bronze = 'fill="url(#leg-bronze-grad)" stroke="#2b1e10" stroke-width="1.5"';
      const hl = 'stroke="#d9b987" stroke-width="3" fill="none" stroke-linecap="round"';
      const legSVG = (i, T) => `<g id="L${i}">
        <path d="M-28 -18Q0 -24 28 -18Q31 ${T / 2} 24 ${T}Q0 ${T + 5} -24 ${T}Q-31 ${T / 2} -28 -18Z" ${bronze}/>
        <path d="M-15 -8Q-17 ${T / 2} -13 ${T - 6}" ${hl} opacity=".35"/>
        <g id="S${i}">
          <path d="M-21 0Q0 -5 21 0Q24 ${S / 2} 18 ${S}Q0 ${S + 4} -18 ${S}Q-24 ${S / 2} -21 0Z" ${bronze}/>
          <path d="M-11 6Q-13 ${S / 2} -10 ${S - 8}" ${hl} opacity=".3"/>
          <circle r="17" fill="#31281e" stroke="#14100a" stroke-width="1.5"/>
          <circle r="15" fill="url(#kn-ring)" stroke="#1d150c" stroke-width="1"/>
          <circle r="11.5" fill="url(#kn-head)" stroke="#2a1d10" stroke-width="1.2"/>
          <circle r="9.3" fill="none" stroke="#f3dca4" stroke-width=".7" opacity=".4"/>
          <g stroke="#2a1d10" stroke-width=".6" opacity=".35"><path d="M0 -11.5V-9.6M0 11.5V9.6M-11.5 0H-9.6M11.5 0H9.6M8.1 -8.1L6.8 -6.8M-8.1 8.1L-6.8 6.8M8.1 8.1L6.8 6.8M-8.1 -8.1L-6.8 -6.8"/></g>
          <g transform="rotate(-35)"><path d="M-7.5 0H7.5M0 -7.5V7.5" stroke="#1a1209" stroke-width="3" stroke-linecap="round"/><path d="M-6.8 .9H6.8M.9 -6.8V6.8" stroke="#8b6a3a" stroke-width=".7" stroke-linecap="round" opacity=".55"/></g>
          <ellipse cx="-4.2" cy="-5.2" rx="3.6" ry="1.7" transform="rotate(-38 -4.2 -5.2)" fill="#fff6dc" opacity=".5"/>
          <g id="F${i}">
            <rect x="-23" y="-6" width="46" height="24" rx="12" fill="#695640" stroke="#32291e" stroke-width="1.5"/>
            <path d="M26 16Q34 24 30 33Q-5 40 -40 33C-56 33-57 21-45 18C-36 15-30 16-26 16Z" fill="#64523e" stroke="#31281e" stroke-width="1.5"/>
            <path d="M30 31Q34 34 30 37Q-6 43 -42 37C-58 37-59 27-55 24Q-51 24 -46 28Q-43 30 -40 31Z" fill="#4c3e2f" stroke="#2a2219" stroke-width="1.5"/>
            <path d="M-30 20Q-45 20-50 27" stroke="#756048" stroke-width="2" fill="none" opacity=".7"/>
          </g>
        </g></g>`;
      legsG.innerHTML = legSVG(1, HIPS[1].T) + legSVG(0, HIPS[0].T); // far leg first

      const part = (id) => $(id);
      const L = HIPS.map((_, i) => ({ t: $('L' + i), s: $('S' + i), f: $('F' + i) }));
      const P = {
        la: part('left-arm-group'), ra: part('right-arm-group'),
        le: part('left-ear'), re: part('right-ear'),
        tail: part('curly-tail-group'), head: part('head-and-ears')
      };
      let openV = 0;   // 0 = hands closed against the body, 1 = free to swing
      const ARM = 0.72;   // arm size (1 = original)
      const armT = (el, a, x, y) => el.setAttribute('transform', `rotate(${a.toFixed(2)} ${x} ${y}) translate(${x} ${y}) scale(${ARM}) translate(${-x} ${-y})`);
      const rot = (el, a, x, y) => el.setAttribute('transform', `rotate(${a.toFixed(2)} ${x} ${y})`);

      // damped springs: parts lag behind the body, overshoot and wobble back like rubber
      const spr = (k, c) => ({
        x: 0, v: 0, k, c, step(tg, dt) { for (let i = 0; i < 3; i++) { const h = dt / 3; this.v += (this.k * (tg - this.x) - this.c * this.v) * h; this.x += this.v * h; } return this.x; },
        busy(tg) { return Math.abs(this.v) > 0.02 || Math.abs(tg - this.x) > 0.02; }
      });
      const SP = { la: spr(95, 3.2), ra: spr(85, 3), tail: spr(60, 2.2), sq: spr(150, 5), sx: spr(150, 5), lean: spr(70, 3.2) };
      const clamp = (v, a) => Math.max(-a, Math.min(a, v));
      let prevDy = 0, prevVy = 0, ay = 0, prevM = 0, dm = 0, springBusy = false, stepNo = 0, primed = false;

      let phi = 0, m = 0, dir = -1, off = 0, last = 0, raf = 0, lite = false, frames = 0, slow = 0;
      const keys = { l: 0, r: 0, shift: 0, run: 0, u: 0, d: 0 };
      // ---- flight: altitude follows a goal through an underdamped spring (springy lift-off + landing)
      const ALT_MAX = 520;
      let goalAlt = 0, alt = 0, vAlt = 0, thrS = 0, flying = false;
      const camG = $('cam'), shadowG = $('ground-shadow'), gimbal = $('jet-gimbal'), flame = $('jet-flame'),
        flameBody = $('jet-flame-body'), ember = $('jet-ember'), btnFly = $('btn-fly');
      const sparks = [...Array(9)].map((_, i) => {
        const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        c.setAttribute('r', (1.6 + (i % 3) * 0.7).toFixed(1)); c.setAttribute('fill', i % 2 ? '#ffd27a' : '#f0a53c');
        $('jet-sparks').appendChild(c); return { c, seed: (i * 0.618) % 1 };
      });

      function pose(ds, dt) {
        dt = dt || 0.016;
        const mm = Math.min(m, 1.6), airK = Math.min(1, alt / 40), hipA = 27 * D * Math.min(m, 1) * (1 - airK), kneeA = 46 * D * mm * (1 - airK);
        let lowest = 0;
        HIPS.forEach((hp, i) => {
          const p = phi + i * Math.PI;
          const h = hipA * Math.sin(p) - airK * (6 + 12 * Math.min(m, 1.7) / 1.7) * D, k = -kneeA * Math.max(0, Math.cos(p)) - airK * 22 * D, a = -(h + k) * 0.85;
          lowest = Math.max(lowest, hp.y + hp.T * Math.cos(h) + S * Math.cos(h + k) + F * Math.cos(h + k + a));
          L[i].t.setAttribute('transform', `translate(${hp.x} ${hp.y}) rotate(${(h / D).toFixed(2)})`);
          L[i].s.setAttribute('transform', `translate(0 ${hp.T}) rotate(${(k / D).toFixed(2)})`);
          L[i].f.setAttribute('transform', `translate(0 ${S}) rotate(${(a / D).toFixed(2)})`);
        });
        const bob = airK * 3.5 * Math.sin(last * 0.004), dyN = GY - lowest - alt + bob, dy = dyN.toFixed(2), s1 = Math.sin(phi), w = Math.sin(2 * phi - 1.2);
        // body motion signals that drive the follow-through
        if (!primed) { prevDy = dyN; primed = true; }
        const vy = (dyN - prevDy) / dt; ay = clamp(0.6 * ay + 0.4 * (vy - prevVy) / dt, 900); prevVy = vy; prevDy = dyN;
        dm = (m - prevM) / dt; prevM = m;
        const sq = SP.sq.step(clamp(ay * 0.00007, 0.06), dt), sx = SP.sx.step(clamp(ay * 0.00004, 0.04), dt);
        const lean = SP.lean.step(clamp(-1.1 * dm, 14), dt);
        const la = SP.la.step(7 * mm * s1 + clamp(ay * 0.012, 14) - lean * 0.8, dt);
        const ra = SP.ra.step(-6 * mm * s1 - clamp(ay * 0.012, 14) - lean * 0.8, dt);
        const tl = SP.tail.step(14 * mm * Math.sin(2 * phi + 0.8) - clamp(ay * 0.02, 22) + lean * 1.4, dt);
        if (m > 0.3 && Math.floor(phi / Math.PI) !== stepNo) { stepNo = Math.floor(phi / Math.PI); if (window.__kickBelly) window.__kickBelly(0.012 * Math.min(m, 1.7)); } // each footfall jiggles the belly
        // engine vibration: fast, tiny shake that grows with thrust (only while airborne)
        const vb = thrS * airK, T = last;
        const vibX = vb * (1.3 * Math.sin(T * 0.085) + 0.7 * Math.sin(T * 0.131 + 2)), vibY = vb * (1.1 * Math.sin(T * 0.097 + 1) + 0.6 * Math.sin(T * 0.153)), vibR = vb * 0.45 * Math.sin(T * 0.11 + 0.5);
        legsG.setAttribute('transform', `translate(${(vibX * 1.3).toFixed(2)} ${(+dy + vibY * 1.3).toFixed(2)})`);
        const bodyRot = ((-2 * mm + 1.2 * mm * Math.sin(2 * phi)) * (1 - airK) + airK * (-11 * Math.min(m, 1.7) / 1.7 + 1.8 * Math.sin(last * 0.003)) + lean * 0.5 + vibR);
        bodyG.setAttribute('transform', `translate(${vibX.toFixed(2)} ${(+dy + vibY).toFixed(2)}) translate(550 790) scale(${(1 + sx).toFixed(4)} ${(1 - sq).toFixed(4)}) translate(-550 -790) rotate(${bodyRot.toFixed(2)} 550 750)`);
        const openT = (m > 0.02 || goalAlt > 0 || alt > 0.4 || Math.abs(vAlt) > 0.5) ? 1 : 0;
        openV += (openT - openV) * Math.min(1, dt * 5);
        if (Math.abs(openT - openV) < 0.002) openV = openT;
        const cl = 1 - openV;
        armT(P.la, (la + vb * 1.6 * Math.sin(T * 0.12)) * openV - 40 * cl, 300, 345);
        armT(P.ra, (ra + vb * 1.6 * Math.sin(T * 0.12 + 1.3)) * openV + 100 * cl, 640, 235);
        rot(P.le, 7 * mm * w, 350, 195);
        rot(P.re, -6 * mm * w, 490, 150);
        rot(P.tail, tl + vb * 2.4 * Math.sin(T * 0.14 + 0.7), 696, 634);
        rot(P.head, 1.5 * mm * Math.sin(2 * phi + 0.5), 440, 260);
        springBusy = Object.values(SP).some((q) => q.busy(0)) || Math.abs(ay) > 5 || openV !== openT;
        // ---- jet: thrust level -> flame size; flame points opposite to where he is heading (back when moving, down when hovering)
        flying = goalAlt > 0 || alt > 0.4 || Math.abs(vAlt) > 0.5;
        const sp = Math.min(1, m / 1.2);
        let thr = flying ? 0.3 + 0.4 * Math.min(1, Math.abs(vAlt) / 150) + 0.3 * sp + (keys.u ? 0.2 : 0) : 0;
        if (vAlt < -30) thr *= 0.55;
        thrS += (Math.min(1, thr) - thrS) * Math.min(1, dt * 9);
        const ang = flying ? 80 - 66 * sp + (keys.u ? 6 : 0) : 40;
        gimbal.setAttribute('transform', `translate(742 672) rotate(${ang.toFixed(1)}) scale(1.4)`);
        const fl = 1 + 0.08 * Math.sin(last * 0.045) + 0.06 * Math.sin(last * 0.11 + 1) + 0.05 * Math.random();
        flame.setAttribute('opacity', Math.min(1, thrS * 3.2).toFixed(2));
        ember.setAttribute('opacity', Math.min(0.9, thrS * 2).toFixed(2));
        flameBody.setAttribute('transform', `translate(30 0) scale(${((0.35 + 1.25 * thrS) * fl).toFixed(3)} ${((0.8 + 0.5 * thrS) * (2 - fl)).toFixed(3)})`);
        sparks.forEach((q) => {
          const tt = (last * 0.0011 * (0.6 + thrS) + q.seed) % 1;
          q.c.setAttribute('cx', (36 + tt * (50 + thrS * 150)).toFixed(1));
          q.c.setAttribute('cy', (Math.sin(q.seed * 40 + last * 0.004) * (3 + tt * 16)).toFixed(1));
          q.c.setAttribute('opacity', (Math.max(0, 1 - tt) * Math.min(1, thrS * 2)).toFixed(2));
        });
        // camera pulls back as he climbs so he stays in frame; shadow shrinks and fades
        const zs = 1 / (1 + alt * 0.0011);
        camG.setAttribute('transform', `translate(500 918) scale(${zs.toFixed(4)}) translate(-500 -918)`);
        shadowG.setAttribute('transform', `translate(560 916) scale(${Math.max(0.35, 1 - alt / 700).toFixed(3)} 1) translate(-560 -916)`);
        shadowG.setAttribute('opacity', Math.max(0.25, 1 - alt / 500).toFixed(2));
        btnFly.classList.toggle('on', goalAlt > 0);
        springBusy = springBusy || flying;
        actor.setAttribute('transform', dir > 0 ? 'translate(1100 0) scale(-1 1)' : '');
        if (ds) { off += dir * ds; groundLine.setAttribute('stroke-dashoffset', off.toFixed(1)); }
      }

      function frame(t) {
        const dt = Math.min((t - last) / 1000, 0.05) || 0.016; last = t;
        const want = keys.r - keys.l;
        if (want) dir = want;
        const target = want ? (keys.shift || keys.run ? 1.7 : 1) : 0;
        const vk = keys.u - keys.d;
        if (vk) goalAlt = Math.max(0, Math.min(ALT_MAX, goalAlt + vk * 230 * dt));
        for (let i = 0; i < 3; i++) { const hh = dt / 3; vAlt += (16 * (goalAlt - alt) - 5.2 * vAlt) * hh; alt += vAlt * hh; if (alt < 0) { alt = 0; vAlt *= -0.25; } }
        m += (target - m) * Math.min(1, dt * 9);
        if (!target && m < 0.02) m = 0;
        const omega = 7.5 * m;
        phi += omega * dt;
        pose(129 * 27 * D * Math.min(m, 1) * omega * 0.9 * dt, dt); // ground speed matches the stance foot
        if (!lite && m > 0.5 && ++frames === 60) { if (slow > 30) setLite(true); frames = slow = 0; }
        if (dt > 0.034) slow++;
        raf = (m > 0 || target || springBusy || goalAlt > 0 || alt > 0.4) ? requestAnimationFrame(frame) : 0;
      }
      const kick = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); } };

      function setLite(v) {
        lite = v;
        document.body.classList.toggle('lite', v);
        btnFx.classList.toggle('on', !v);
      }
      btnFx.addEventListener('click', () => setLite(!lite));
      btnRun.addEventListener('click', () => { keys.run ^= 1; btnRun.classList.toggle('on', !!keys.run); kick(); });

      const KM = { ArrowLeft: 'l', a: 'l', A: 'l', ArrowRight: 'r', d: 'r', D: 'r', ArrowUp: 'u', w: 'u', W: 'u', ' ': 'u', ArrowDown: 'd', s: 'd', S: 'd' };
      const setKey = (e, v) => {
        keys.shift = e.shiftKey ? 1 : 0;
        const k = KM[e.key];
        if (k) { keys[k] = v; e.preventDefault(); }
        kick();
      };
      addEventListener('keydown', (e) => { if ((e.key === 'f' || e.key === 'F') && !e.repeat) { goalAlt = goalAlt > 0 ? 0 : 170; kick(); } setKey(e, 1); });
      btnFly.addEventListener('click', () => { goalAlt = goalAlt > 0 ? 0 : 170; kick(); });
      addEventListener('keyup', (e) => setKey(e, 0));
      addEventListener('blur', () => { keys.l = keys.r = keys.shift = keys.u = keys.d = 0; });

      [['btn-left', 'l'], ['btn-right', 'r'], ['btn-up', 'u'], ['btn-down', 'd']].forEach(([id, k]) => {
        const b = $(id), on = () => { keys[k] = 1; kick(); }, offf = () => { keys[k] = 0; };
        b.addEventListener('pointerdown', on);
        ['pointerup', 'pointerleave', 'pointercancel'].forEach((ev) => b.addEventListener(ev, offf));
      });

      pose(0);
    })();
  </script>

  <script>
    // ================= BALLOON INFLATION =================
    // Every belly shape keeps its original geometry in data-o / data-e and is
    // re-pushed outward from the belly centre by a smooth bump (a: 0 = flat, 1 = balloon).
    (function () {
      const CX = 560, CY = 650;
      const paths = [...document.querySelectorAll('[data-o]')].map((el) => ({
        el, tok: el.getAttribute('data-o').match(/[MCLZ]|-?\d+(?:\.\d+)?/g)
      }));
      const ells = [...document.querySelectorAll('[data-e]')].map((el) => {
        const [cx, cy, rx, ry, ang] = el.getAttribute('data-e').split(' ').map(Number);
        return { el, cx, cy, rx, ry, ang };
      });
      const mount = document.getElementById('tail-mount'), slotF = document.getElementById('slot-follow'), jetF = document.getElementById('jet-follow');
      const slider = document.getElementById('inflate'), label = document.getElementById('inflate-label');
      const f = (v) => v.toFixed(1);

      function apply(a, st, wob) {
        st = st || 0; wob = wob || 0;       // st: + = taller & thinner, - = squashed & wider; wob: ripple through the skin
        const sg = 150 + 70 * a, gain = 0.9 * a, grow = 1 + 0.55 * a;
        const push = (x, y) => {
          const dx = x - CX, dy = y - CY, r2 = dx * dx + dy * dy, k = gain * Math.exp(-r2 / (2 * sg * sg));
          // rubber ripple: a wave travelling outward from the belly centre
          const ang = Math.atan2(dy, dx), ripple = 1 + wob * Math.sin(Math.sqrt(r2) * 0.035 - ripplePhase + ang * 2);
          return [x + dx * k * ripple * (1 - st), y + dy * k * ripple * (1 + st)];
        };
        for (const p of paths) {
          let out = '', i = 0;
          const t = p.tok;
          while (i < t.length) {
            if (/[MCLZ]/.test(t[i])) { out += t[i++] + ' '; continue; }
            const [nx, ny] = push(+t[i], +t[i + 1]);
            out += f(nx) + ' ' + f(ny) + ' '; i += 2;
          }
          p.el.setAttribute('d', out.trim());
        }
        for (const e of ells) {
          const [nx, ny] = push(e.cx, e.cy);
          e.el.setAttribute('cx', f(nx)); e.el.setAttribute('cy', f(ny));
          e.el.setAttribute('rx', f(e.rx * grow * (1 - st * 0.6))); e.el.setAttribute('ry', f(e.ry * grow * (1 + st * 0.6)));
          if (e.ang) e.el.setAttribute('transform', `rotate(${e.ang} ${f(nx)} ${f(ny)})`);
        }
        const [tx, ty] = push(696, 634);
        mount.setAttribute('transform', `translate(${f(tx - 696)} ${f(ty - 634)})`);
        // the belly hole (coin slot) ignores the springy jiggle/ripple: it only follows the slow inflate level, so it never vibrates while moving
        const aS = Math.min(1.3, goalLevel()), sgS = 150 + 70 * aS, gS = 0.9 * aS, dxS = 545 - CX, dyS = 450 - CY, kS = gS * Math.exp(-(dxS * dxS + dyS * dyS) / (2 * sgS * sgS));
        const px = 545 + dxS * kS, py = 450 + dyS * kS, ss = 1 + 0.3 * aS;
        slotF.setAttribute('transform', `translate(${f(px - 545)} ${f(py - 450)}) translate(545 450) scale(${f(ss)} ${f(ss)}) translate(-545 -450)`);
        const [jx, jy] = push(742, 672); jetF.setAttribute('transform', `translate(${f(jx - 742)} ${f(jy - 672)})`);
        label.textContent = Math.round(Math.min(a, 1) * 100) + '%';
      }
      let ripplePhase = 0;
      const goalLevel = () => goal;

      // spring physics: the skin overshoots, wobbles and settles like stretched rubber
      const K = 0.075, DAMP = 0.045;                 // stiffness / damping (lower damping = more jiggle)
      let level = +slider.value / 100, goal = level, vel = 0, pumping = 0, raf = 0, last = 0, stroke = 0;
      function tick(now) {
        const dt = Math.min((now - last) / 16.667 || 1, 2.5); last = now;
        if (pumping) {
          goal = Math.min(1, goal + 0.0075 * dt);
          stroke += dt;
          if (stroke > 12) { stroke = 0; vel += 0.055; }   // each pump stroke = a little "pfff" kick
        }
        vel += (K * (goal - level) - DAMP * vel) * dt;
        level += vel * dt;
        if (level < 0) { level = 0; vel *= -0.4; }
        const a = Math.min(1.3, level);
        ripplePhase += 0.35 * dt * (0.4 + Math.min(1, Math.abs(vel) * 18));
        const wob = Math.min(0.12, Math.abs(vel) * 2.2);          // skin ripples while it's moving
        apply(a, Math.max(-0.34, Math.min(0.34, vel * 6.5)), wob); // fast growth = stretch, rebound = squash
        slider.value = Math.round(goal * 100);
        const alive = pumping || Math.abs(goal - level) > 0.0008 || Math.abs(vel) > 0.0006;
        raf = alive ? requestAnimationFrame(tick) : 0;
        if (!alive) apply(goal, 0);
      }
      const kick = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(tick); } };

      slider.addEventListener('input', () => { goal = +slider.value / 100; kick(); });
      const pump = document.getElementById('btn-pump');
      pump.addEventListener('pointerdown', () => { pumping = 1; kick(); });
      ['pointerup', 'pointerleave', 'pointercancel'].forEach((ev) => pump.addEventListener(ev, () => { pumping = 0; }));
      document.getElementById('btn-deflate').addEventListener('click', () => { goal = 0; kick(); });
      addEventListener('keydown', (e) => { if (e.key === 'p' || e.key === 'P') { pumping = 1; kick(); } });
      addEventListener('keyup', (e) => { if (e.key === 'p' || e.key === 'P') pumping = 0; });
      addEventListener('blur', () => { pumping = 0; });

      document.getElementById('torso-main').addEventListener('click', () => { vel += 0.16; kick(); });   // poke the belly: boing
      window.__kickBelly = (v) => { vel += v; kick(); };
      window.__setInflate = (v) => { goal = level = v; vel = 0; apply(v, 0); slider.value = Math.round(v * 100); };  // handy for testing
      apply(level);
    })();
  </script>

  <script>
    // ================= GOLD LIGHT BLINK (coin slot) =================
    // Every few seconds a premium golden light flashes out of the slot: a quick double pulse that fades away.
    (function () {
      const light = document.getElementById('slot-light'), rays = document.getElementById('gl-rays-in'),
        bloom = document.getElementById('gl-bloom-el'), sa = document.getElementById('gl-star-a'), sb = document.getElementById('gl-star-b');
      if (!light) return;
      const bump = (t, c, w) => Math.exp(-(((t - c) / w) ** 2));
      const DUR = 2200;
      function pulse() {
        const t0 = performance.now(), spin = Math.random() * 40;
        (function step(now) {
          const t = (now - t0) / DUR;
          if (t >= 1) { light.setAttribute('opacity', '0'); schedule(); return; }
          const e = Math.min(1, bump(t, 0.3, 0.2) + 0.3 * bump(t, 0.62, 0.15)) * 0.8;
          light.setAttribute('opacity', e.toFixed(3));
          rays.setAttribute('transform', `rotate(${(spin + t * 12).toFixed(2)}) scale(${(0.5 + 0.4 * e).toFixed(3)})`);
          bloom.setAttribute('transform', `rotate(-34 578 378) translate(578 378) scale(${(0.9 + 0.12 * e).toFixed(3)}) translate(-578 -378)`);
          sb.setAttribute('transform', `translate(610 418) rotate(${(-t * 90).toFixed(1)}) scale(${(0.2 + 0.7 * bump(t, 0.4, 0.22)).toFixed(3)})`);
          requestAnimationFrame(step);
        })(t0);
      }
      function schedule() { setTimeout(pulse, 2800 + Math.random() * 4200); }
      setTimeout(pulse, 1200);   // first blink shortly after load
    })();
  </script>
