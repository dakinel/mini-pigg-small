<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Balloon Steampunk Piggybank Robot — Precision SVG Illustration</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background-color: #ffffff;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      overflow: hidden;
      user-select: none;
    }

    /* Subtle architectural grid option for inspection */
    .bg-inspect-grid {
      background-image:
        linear-gradient(to right, rgba(0, 0, 0, 0.035) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.035) 1px, transparent 1px);
      background-size: 28px 28px;
    }

    #stage {
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      cursor: grab;
    }

    #stage:active {
      cursor: grabbing;
    }

    #robot-svg {
      width: min(92vw, 92vh);
      height: min(92vw, 92vh);
      max-width: 960px;
      max-height: 960px;
      transition: transform 0.12s ease-out;
      will-change: transform;
    }

    /* Lite mode: drops the heavy procedural texture filters (auto-enabled on slow devices) */
    body.lite [filter] {
      filter: none !important;
    }

    #controls button {
      touch-action: none;
    }

    #controls button.on {
      background: #171717;
      color: #fff;
    }
  </style>
</head>

