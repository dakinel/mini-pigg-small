          <feBlend mode="multiply" in="SourceGraphic" in2="clippedNoise" />
        </filter>

        <!-- Fine copper hammered/oxidized texture for lower belly -->
        <filter id="copper-texture" x="-5%" y="-5%" width="110%" height="110%">
